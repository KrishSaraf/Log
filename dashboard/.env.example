DATABASE_URL=postgresql://krishsaraf@localhost:5432/log_all

# Auth.js (Google + Apple). See docs/AUTH.md
AUTH_SECRET=           # openssl rand -base64 32
AUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Local testing without Google/Apple (set both). Never enable in production.
AUTH_DEV_LOGIN=1
NEXT_PUBLIC_AUTH_DEV_LOGIN=1
# NEXT_PUBLIC_AUTH_GOOGLE=1
# NEXT_PUBLIC_AUTH_APPLE=1

# NVIDIA NIM (OpenAI-compatible). Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Vision-capable model. 11B is fast; switch to meta/llama-3.2-90b-vision-instruct for harder photos.
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
